{
  "expo": {
    "name": "SUGOMATE",
    "slug": "sugomate",
    "owner": "cdm-prime",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sugomate",
    "android": {
      "package": "com.sugomate.app"
    },
    "ios": {
      "bundleIdentifier": "com.sugomate.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SUGOMATE needs photo access so you can upload your GCash payment receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff7ef"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2911cdaa-1c15-4f19-9327-6e8276bf133b"
      }
    }
  }
}