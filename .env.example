NEXT_PUBLIC_SUPABASE_URL=https://wjfbdcaojfwhotrmihfk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-sugomate-publishable-key
NEXT_PUBLIC_SITE_URL=https://sugomate.com

# Server-only Supabase admin key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Existing SUGOMATE Textbee gateway (shared with registration phone OTP).
TEXTBEE_API_KEY=replace-with-textbee-api-key

# Existing SUGOMATE mailbox SMTP (same provider and sender as Supabase Auth).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=noreply@sugomate.com
SMTP_PASSWORD=replace-with-existing-mailbox-password
SMTP_FROM_EMAIL=noreply@sugomate.com
SMTP_FROM_NAME=SUGOMATE

# Protects the scheduled receipt worker endpoint.
CRON_SECRET=replace-with-a-long-random-secret
